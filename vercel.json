{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.bluestardevelopment.nl" }],
      "destination": "https://bluestardevelopment.nl/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/website-laten-maken", "destination": "/website-laten-maken/index.html" },
    { "source": "/webapplicatie-laten-maken", "destination": "/webapplicatie-laten-maken/index.html" },
    { "source": "/website-onderhoud", "destination": "/website-onderhoud/index.html" },
    { "source": "/prijzen", "destination": "/prijzen/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/over-ons", "destination": "/over-ons/index.html" },
    { "source": "/portfolio", "destination": "/portfolio/index.html" },
    { "source": "/privacybeleid", "destination": "/privacybeleid/index.html" },
    { "source": "/algemene-voorwaarden", "destination": "/algemene-voorwaarden/index.html" },
    { "source": "/disclaimer", "destination": "/disclaimer/index.html" },
    { "source": "/portfolio/:slug", "destination": "/portfolio/:slug/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Vary",
          "value": "Accept-Encoding"
        }
      ]
    },
    {
      "source": "/(.*)\\.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)\\.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)\\.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)\\.webm",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)\\.pdf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
